<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Know where the phone is, only while a trip is on. Stays on the phone. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Open the link Google Maps shares, to find the stop's position. Your location is never sent. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keep the trip running while the screen is off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Show the "WAKE UP" alarm notification (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Vibrate the phone -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Show the alarm screen over the lock screen -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WakeMeUp">

        <!-- The main screen -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Makes "Wake Me Up" appear when you tap Share on a place in Google Maps -->
            <intent-filter android:label="Save as my stop">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Runs only while a trip is on: watches your position and rings near your stop -->
        <service
            android:name=".TripService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Handles the STOP ALARM button on the notification -->
        <receiver
            android:name=".StopAlarmReceiver"
            android:exported="false" />
    </application>

</manifest>
